				{
					"name": "Create Customer",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"if (pm.response.code === 201) {",
									"    var json = pm.response.json();",
									"    pm.collectionVariables.set('customer_number', json.number);",
									"    console.log('Saved customer_number: ' + json.number);",
