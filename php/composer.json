{
  "name": "amen/starter-kit",
  "description": "Reference PHP client and examples for the Amen Platform API",
  "type": "project",
  "license": "MIT",
  "require": { "php": ">=8.1", "ext-curl": "*", "ext-json": "*" },
  "require-dev": { "phpunit/phpunit": "^10.5" },
  "autoload": { "psr-4": { "Amen\\": "src/Amen/" } },
  "autoload-dev": { "psr-4": { "Amen\\Tests\\": "tests/" } },
  "scripts": { "test:unit": "phpunit tests/Unit", "test:integration": "phpunit tests/Integration" }
}
