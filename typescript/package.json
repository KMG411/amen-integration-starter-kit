{
  "name": "amen-starter-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Reference TypeScript client and examples for the Amen Platform API",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "example:golden-path": "tsx examples/01_golden_path.ts",
    "example:cancel": "tsx examples/02_cancel_and_dispute.ts cancel",
    "example:withdrawal": "tsx examples/03_withdrawal.ts",
    "example:webhook": "tsx examples/04_webhook_receiver.ts"
  },
  "dependencies": { "dotenv": "^16.4.5" },
  "devDependencies": { "typescript": "^5.5.4", "tsx": "^4.19.0", "vitest": "^2.0.5", "@types/node": "^20.14.0" }
}
